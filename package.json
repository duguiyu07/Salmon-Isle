{
  "name": "salmon-isle",
  "version": "1.1.3",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/duguiyu07/Salmon-Isle.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:http": "tsx tests/http-smoke.ts",
    "test:git-http": "tsx tests/git-http-smoke.ts",
    "setup": "tsx scripts/setup.ts",
    "import:wordpress": "tsx scripts/import-wordpress.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "repair:wordpress": "tsx scripts/repair-wordpress.ts",
    "repair:captions": "tsx scripts/repair-captions.ts",
    "migrate:pages": "tsx scripts/migrate-pages.ts",
    "test:standalone": "tsx tests/http-smoke.ts --standalone",
    "migrate:git": "tsx scripts/migrate-git.ts",
    "desktop:install": "npm --prefix desktop ci",
    "desktop:prepare": "tsx scripts/prepare-desktop.ts",
    "desktop:start": "npm --prefix desktop start",
    "desktop:package": "npm run build && npm run desktop:prepare && npm --prefix desktop run package",
    "desktop:smoke": "tsx scripts/test-desktop.ts",
    "release:metadata": "tsx scripts/release-metadata.ts",
    "release:source": "tsx scripts/release-source.ts",
    "release:deployment": "tsx scripts/release-deployment.ts",
    "prepare:deployment": "tsx scripts/prepare-deployment.ts"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.6",
    "@milkdown/kit": "^7.23.0",
    "@wordpress/block-serialization-default-parser": "^5.35.0",
    "cheerio": "^1.1.2",
    "codemirror": "^6.0.2",
    "diff": "^9.0.0",
    "fast-xml-parser": "^5.3.0",
    "fflate": "^0.8.2",
    "katex": "^0.16.25",
    "lucide-react": "^0.548.0",
    "mathml-to-latex": "^1.8.0",
    "next": "^16.0.0",
    "postcss": "^8.5.23",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rehype-katex": "^7.0.1",
    "rehype-pretty-code": "^0.14.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-cjk-friendly": "^2.3.3",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "shiki": "^3.13.0",
    "tar": "7.5.22",
    "turndown": "^7.2.1",
    "turndown-plugin-gfm": "^1.0.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/turndown": "^5.0.6",
    "jsdom": "^30.1.3",
    "sharp": "0.35.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild"
    ]
  }
}
