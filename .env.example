SALMON_DATA_DIR=./data
SALMON_ORIGIN=http://localhost:3000
# Run npm run setup to create an administrator setup token.
# Never prefix secrets with NEXT_PUBLIC_.
SALMON_ADMIN_HASH=
SALMON_SECURE_COOKIES=false
# Enable after migrating to a dedicated private content repository.
# In Docker use a path under the persistent /data volume, e.g. /data/library.
SALMON_CONTENT_REPO_DIR=
SALMON_CONTENT_REMOTE=
SALMON_CONTENT_BRANCH=main
SALMON_SYNC_INTERVAL_MS=30000
# Program updates use the public source repository, separate from content.
# Production image (pin the release version; the server does not build it):
# SALMON_WEB_IMAGE=ghcr.io/duguiyu07/salmon-isle:1.1.0
SALMON_RELEASE_MANIFEST_URL=https://github.com/duguiyu07/Salmon-Isle/releases/latest/download/release.json
SALMON_DESKTOP_UPDATE_URL=https://github.com/duguiyu07/Salmon-Isle/releases/latest/download/
